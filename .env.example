# Local development:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel production:
# NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
# After adding your custom domain:
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional single-owner login. When these are set, email login uses this password
# instead of sending Supabase OTP emails.
OWNER_AUTH_EMAIL=owner@company.com
OWNER_AUTH_PASSWORD=change-this-password
OWNER_AUTH_NAME=Owner
OWNER_AUTH_ID=00000000-0000-0000-0000-000000000001
OWNER_AUTH_SECRET=change-this-long-random-secret
